#!/bin/bash
set -eo pipefail

# Keep each service name intact, including spaces; skip the header and disabled services.
services() {
    /usr/sbin/networksetup -listallnetworkservices | /usr/bin/tail -n +2
}

owns_proxy() {
    local state
    state=$(/usr/sbin/networksetup "$1" "$2") || return 2
    /usr/bin/grep -qxF "Enabled: Yes" <<< "$state" &&
    /usr/bin/grep -qxF "Server: $3" <<< "$state" &&
    /usr/bin/grep -qxF "Port: $4" <<< "$state"
}

service_list=$(services)

case "$1" in
    set)
        [ "$#" -ge 3 ] || exit 1
        host=$2; port=$3; shift 3
        [ "$#" -gt 0 ] || set -- "Empty"
        while IFS= read -r service; do
            [[ -z "$service" || "$service" == \** ]] && continue
            /usr/sbin/networksetup -setwebproxy "$service" "$host" "$port"
            /usr/sbin/networksetup -setsecurewebproxy "$service" "$host" "$port"
            /usr/sbin/networksetup -setsocksfirewallproxy "$service" "$host" "$port"
            /usr/sbin/networksetup -setproxybypassdomains "$service" "$@"
        done <<< "$service_list"
        ;;
    clear|clear-owned)
        mode=$1; host=${2-}; port=${3-}
        [[ "$mode" != clear-owned || "$#" -eq 3 ]] || exit 1
        while IFS= read -r service; do
            [[ -z "$service" || "$service" == \** ]] && continue
            for kind in webproxy securewebproxy socksfirewallproxy; do
                if [[ "$mode" == clear ]] || owns_proxy "-get$kind" "$service" "$host" "$port"; then
                    /usr/sbin/networksetup "-set${kind}state" "$service" off
                else
                    # Distinguish an unrelated endpoint from a failed ownership query.
                    [[ "$?" -eq 1 ]] || exit 1
                fi
            done
        done <<< "$service_list"
        ;;
    *) exit 1 ;;
esac
