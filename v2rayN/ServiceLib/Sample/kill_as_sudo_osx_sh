#!/bin/bash
# Snapshot owned descendants before stopping sudo: otherwise the root child can be
# reparented before enumeration and keep a TUN interface/routes alive.
[[ "$#" -eq 1 && "$1" =~ ^[0-9]+$ && "$1" -gt 1 ]] || exit 1
root=$1
kill -0 "$root" 2>/dev/null || exit 0
pids=()
collect() {
    local child
    for child in $(/bin/ps -axo pid=,ppid= | /usr/bin/awk -v parent="$1" '$2==parent {print $1}'); do
        collect "$child"
        pids+=("$child")
    done
}
collect "$root"
# Let sing-box release its TUN/routes before stopping its sudo monitor.
for pid in "${pids[@]}"; do kill -TERM "$pid" 2>/dev/null || true; done
for attempt in 1 2 3 4 5; do
    alive=0
    for pid in "${pids[@]}"; do kill -0 "$pid" 2>/dev/null && alive=1; done
    [[ "$alive" -eq 0 ]] && break
    sleep 0.2
done
for pid in "${pids[@]}"; do kill -KILL "$pid" 2>/dev/null || true; done
kill -TERM "$root" 2>/dev/null || true
